{
  "name": "@loompilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && depcruise --config .dependency-cruiser.cjs src",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs src",
    "test": "vitest run",
    "seed": "tsx src/seed/seed.ts"
  },
  "dependencies": {
    "@loompilot/agents-client": "workspace:*",
    "@loompilot/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.0",
    "p-retry": "^6.2.1",
    "pdfmake": "^0.2.18",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.1",
    "@types/pdfmake": "^0.2.11",
    "@types/supertest": "^6.0.2",
    "dependency-cruiser": "^18.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
