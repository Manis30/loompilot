# LoomPilot Environment Variables Configuration
# Copy this file to .env before starting the services
# Note: In production, secrets must be minimum 32 characters and must not contain 'change_me'

# Application & Environment
APP_NAME=LoomPilot
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (MongoDB Atlas / Replica Set)
MONGODB_URI=mongodb://localhost:27017/loompilot?replicaSet=rs0
MONGODB_DB_NAME=loompilot
MONGODB_USER=loompilot_admin
MONGODB_PASSWORD=loompilot_admin_pass
MONGODB_DATABASE=loompilot
MONGODB_RO_URI=mongodb://agent_ro:agent_ro_pass@localhost:27017/loompilot?replicaSet=rs0&authSource=loompilot

# Redis (BullMQ & Realtime)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_ACCESS_SECRET=loompilot_dev_jwt_secret_change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=loompilot_dev_refresh_jwt_secret_change_me_min_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_SECRET=loompilot_dev_jwt_secret_change_me_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Internal Service-to-Service Communication (Agent Gateway)
AGENT_SERVICE_TOKEN=loompilot_internal_agent_gateway_token_change_in_prod
INTERNAL_SERVICE_TOKEN=loompilot_internal_agent_gateway_token_change_in_prod

# Python Agents Service
AGENTS_BASE_URL=http://localhost:8000
AGENTS_SERVICE_URL=http://localhost:8000
AGENTS_PORT=8000
AGENTS_HOST=0.0.0.0
NODE_API_URL=http://localhost:4000

# CORS & Web Client
CORS_ORIGINS=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
WEB_URL=http://localhost:5173

# Multi-Tenancy Defaults
TENANT_DEFAULT_ID=default
TENANT_TIMEZONE=Asia/Kolkata

# Rate Limiting & Request Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
BODY_LIMIT=10mb

# Stage 3 Auth, Lockout & Abuse Protection
BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5
LOCKOUT_DURATION_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
INVITE_TOKEN_TTL=7d

# Notifications & Mailer (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@loompilot.local
SMTP_FROM=no-reply@loompilot.local

# File Storage
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./uploads

# LLM Provider Configuration (fake | anthropic)
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Notification Integrations (Stubs)
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
SMS_API_KEY=
SMS_SENDER_ID=
