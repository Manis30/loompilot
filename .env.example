# LoomPilot Environment Variables Configuration
# Copy this file to .env before starting the services

# Application Identity
APP_NAME=LoomPilot
NODE_ENV=development

# Node API Configuration
API_PORT=4000
API_HOST=0.0.0.0
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication & Security (Generate secure random secrets in production)
JWT_SECRET=loompilot_dev_jwt_secret_change_me_in_production_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=loompilot_dev_refresh_jwt_secret_change_me_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Internal Service-to-Service Communication
# Used for /internal/* agent gateway endpoints
INTERNAL_SERVICE_TOKEN=loompilot_internal_agent_gateway_token_change_in_prod

# Database: MongoDB Single-Node Replica Set
MONGODB_URI=mongodb://localhost:27017/loompilot?replicaSet=rs0
MONGODB_USER=loompilot_admin
MONGODB_PASSWORD=loompilot_admin_pass
MONGODB_DATABASE=loompilot

# Read-Only Database User for Agents
MONGODB_RO_URI=mongodb://agent_ro:agent_ro_pass@localhost:27017/loompilot?replicaSet=rs0&authSource=loompilot

# Redis (BullMQ & Realtime)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Python Agents Service Configuration
AGENTS_PORT=8000
AGENTS_HOST=0.0.0.0
AGENTS_SERVICE_URL=http://localhost:8000
NODE_API_URL=http://localhost:4000

# LLM Provider Configuration (fake | anthropic)
# Default is fake: requires no API keys, fully deterministic
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# Notification Integrations (Stubs)
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=
SMS_API_KEY=
SMS_SENDER_ID=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@loompilot.local
